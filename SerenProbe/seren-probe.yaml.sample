# ═══════════════════════════════════════════════════════════════════════
#  seren-probe.yaml - config for SerenProbe (RAG Evaluation Viewer)
# ═══════════════════════════════════════════════════════════════════════
#
#  Copy to seren-probe.yaml, edit, and run:
#     python -m seren_probe --config seren-probe.yaml
#
#  Or just run with no config at all - the defaults below are baked in, so
#  `python -m seren_probe` works zero-config for a local dev spin.
#
#  Env vars override file values (handy for Docker/systemd):
#     SEREN_PROBE_PORT, SEREN_PROBE_HOST, SEREN_PROBE_BEARER_TOKEN,
#     SEREN_PROBE_MEMORY_URL, SEREN_PROBE_LOCI_NV_URL, SEREN_PROBE_LOCI_V_URL,
#     SEREN_PROBE_SCC_NV_URL, SEREN_PROBE_SCC_V_URL, SEREN_PROBE_CAPTURE_PATH,
#     SEREN_PROBE_TRUST_SYSTEM_STORE, SEREN_PROBE_STATE_DIR
#
# ═══════════════════════════════════════════════════════════════════════

server:
  host: 127.0.0.1
  # allow_open_lan: false
  #   A host beyond loopback with no token REFUSES TO START and prints the
  #   three ways out. Set this true (or <PREFIX>_ALLOW_OPEN_LAN=1) to run open on
  #   purpose - a trusted LAN, a lab - and it will say so on every boot.
  port: 7430             # family map: lodestar 6361, memory 7420, margin 7421,
                          # loci 7422, callosum 7423, workbench 7425, probe 7430,
                          # observatory 7777. There is ONE Loci per box; "vector"
                          # is a flag on it, not a second port.
  # Pointer, not secret: prefer bearer_token_env / bearer_token_keyring.
  bearer_token: ""

stores:
  # DELIBERATELY EMPTY. These are the addresses of the operator's LIVE brain,
  # and nothing in the evaluation path reads them: SerenProbe only scores
  # containers it spun up itself (POST /docker/start), and write_guard refuses
  # a write anywhere else. They survive as an operator-settable display on
  # /eval/config and nothing more. This sample used to hand you all five
  # filled in - and put loci_v on 7421, which is SerenMargin's port. An
  # address you have to TYPE is a decision; one that arrives as a default is
  # an accident waiting for a tired Tuesday.
  # memory_url: ""
  # loci_nv_url: ""
  # loci_v_url: ""
  # scc_nv_url: ""
  # scc_v_url: ""
  # Path for locomo sweep captures.
  capture_path: /tmp/scc_capture2.json

# -- Where SerenProbe keeps its own state ------------------------------------
# One directory holds everything Probe writes about itself:
#   topology_state.json   - the running pod's identity, so a restart ADOPTS it
#                           instead of rebuilding and reseeding
#   eval_results.json     - the last eval's scores, so they survive a restart
#   corpus_captures.json  - frozen store responses the regrade sweep replays
#   docker_configs/       - saved Dockerfile / compose deployment configs
#
# Default ~/.seren-probe. Set it per install when one host runs more than one
# cluster (e.g. ~/seren/<install>/stores/probe) - two Probes sharing one state
# dir will each adopt the other's pod. ~ is expanded; absolute paths are used
# as-is. SEREN_PROBE_STATE_DIR beats this value.
#
# docker_configs precedence: SERENPROBE_DOCKER_CONFIG_DIR (old override) wins;
# then <state_dir>/docker_configs when state_dir is set; with state_dir UNSET,
# an existing ~/.serenprobe/docker_configs (the old location) is still used so
# configs saved there are not stranded.
# storage:
#   state_dir: ~/.seren-probe

# -- Corporate / intercepting-proxy support (opt-in) ------------------------
# If you're on a corporate network that does TLS interception (Zscaler,
# Netskope, etc.), the proxy's root CA is in your OS trust store but not in
# Python's bundled certs, so outbound HTTPS calls to store services fail.
# Turn this on to route TLS through the OS trust store.
#
# Requires the corp extra:  pip install "seren-probe[corp]"
# tls:
#   trust_system_store: true

# ── Update checking ───────────────────────────────────────────────────
#
# Asks the package index whether a newer seren-probe exists, and reports it on
# GET /. Purely informational - the service never upgrades itself. Applying
# an update is `pip install -U seren-probe` plus a restart, which belongs to your
# service supervisor (systemd, NSSM), not to this process.
#
# Enabled here by default, but it only DOES anything if the checking code is
# installed:  pip install 'seren-probe[updates]'
# Without that you get status="unavailable" plus a reason - never a quiet
# "you're up to date" from something that never actually looked.
#
# The result is cached for check_interval_hours and the lookup never happens
# in the request path, so the route stays fast.
updates:
  enabled: true
  check_interval_hours: 6      # cached; never checked per-request
  allow_prerelease: false      # true would offer you e.g. 2.0.0rc1
  # index_url: "https://pypi.org/pypi/{distribution}/json"   # private index?
